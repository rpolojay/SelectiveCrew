const storage = getStorage();
import { getSBBody, getNclPhotoBody, getVideoEmail, getOmniaEmail, getVisaEmail, getFinalPrepEmail, getSecurityEmail, getSTCWEmail, getRCLCELMedicalEmail, getVirginVoyagesMedicalEmail, getSparkVideoEmail, getSelectedStarboardEmail, getCarnivalVirginMedicalEmail, getTrainingInviteEmail, getTrainingCompletionEmail, getRejectionEmail, getTrainingCourseEmail, getPhotographerDocsEmail, getNclVisaEmail, getStarboardSystemEmail } from '../../lib/emailTemplates';

const navy  = '#0a1628';
const ocean = '#0e4d8a';
const gold  = '#c9a84c';
const teal  = '#0d9488';

const PIPELINE_STAGES = [
