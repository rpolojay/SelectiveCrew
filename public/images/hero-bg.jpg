<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a472a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2d5a3b;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="1200" height="400" fill="url(#grad)"/>
  <text x="600" y="200" text-anchor="middle" fill="white" font-size="40" font-family="Arial">Selective Crew</text>
  <text x="600" y="250" text-anchor="middle" fill="#ffd700" font-size="20" font-family="Arial">Your Career at Sea Starts Here</text>
</svg>
